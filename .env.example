# 应用配置
APP_NAME=mywebproject
APP_VERSION=0.1.0
# 可选值：dev / test / prod
APP_ENV=dev
DEBUG=false

# 后端服务配置
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Docker 网络内前端 Nginx 代理使用的后端地址
BACKEND_API_URL=http://backend:8000

# Docker Compose 中使用服务名 db；本机直接运行后端时改为 127.0.0.1
DATABASE_URL=mysql+aiomysql://root:change-me@db:3306/mywebproject
DATABASE_NAME=mywebproject
DATABASE_ROOT_PWD=change-me
