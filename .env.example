# 应用配置
APP_NAME=mywebproject
APP_VERSION=0.1.0
# 可选值：dev / test / prod
APP_ENV=dev
DEBUG=false

# 后端服务配置
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Docker 网络内前端 Nginx 代理使用的后端地址
BACKEND_API_URL=http://backend:8000

# 本机直接运行后端时使用；Docker Compose 会通过 db 服务名自动构造连接地址
DATABASE_URL=mysql+aiomysql://root:change-me@127.0.0.1:3306/mywebproject?charset=utf8mb4

# Docker MySQL 使用该名称创建数据库，init.sql 会初始化这个库
DATABASE_NAME=mywebproject
DATABASE_ROOT_PWD=change-me

# 首次启动时自动写入示例文章；生产环境可设为 false
SEED_DATA=true
