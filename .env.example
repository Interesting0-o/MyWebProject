# 应用配置
APP_NAME=mywebproject
APP_VERSION=0.1.0
# 可选值：dev / test / prod
APP_ENV=dev
DEBUG=false

# 后端服务配置
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# 数据库配置（MySQL/MariaDB）
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/mywebproject
DATABASE_NAME= mywebproject
DATABASE_ROOT_PWD=
